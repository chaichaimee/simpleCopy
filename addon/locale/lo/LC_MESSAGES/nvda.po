#: __init__.py:225
msgid "Append"
msgstr "ຕໍ່ທ້າຍ"

#: clipboard_utils.py:229
msgid "Appended"
msgstr "ຕໍ່ທ້າຍແລ້ວ"

#: clipboard_utils.py:205
msgid "Cannot append to non-text clipboard content"
msgstr "ບໍ່ສາມາດຕໍ່ທ້າຍໃສ່ເນື້ອຫາຄລິບບອດທີ່ບໍ່ແມ່ນຂໍ້ຄວາມໄດ້"

#: __init__.py:174
msgid "Clean"
msgstr "ລ້າງຄລິບບອດ"

#: clipboard_utils.py:229
msgid "Copied"
msgstr "ສຳເນົາແລ້ວ"

#: __init__.py:116
#: __init__.py:128
msgid "Copy"
msgstr "ສຳເນົາ"

#: __init__.py:234
msgid "Copy Until Last"
msgstr "ສຳເນົາຈົນຮອດຂໍ້ຄວາມສຸດທ້າຍ"

#: __init__.py:80
msgid "Error during append operation"
msgstr "ເກີດຂໍ້ຜິດພາດໃນລະຫວ່າງການຕໍ່ທ້າຍ"

#: clipboard_utils.py:236
msgid "Error writing to clipboard"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຂຽນລົງຄລິບບອດ"

#: __init__.py:239
msgid "Navigate speech history: previous (single) next (double) open log file (triple)"
msgstr "ທ່ອງທ່ຽວປະຫວັດການເວົ້າ: ກ່ອນໜ້າ (ກົດເທື່ອດຽວ) ຖັດໄປ (ກົດສອງເທື່ອ) ເປີດໄຟລ໌ບັນທຶກເຫດການ (ກົດສາມເທື່ອ)"

#: __init__.py:118
msgid "No URL"
msgstr "ບໍ່ມີ URL"

#: __init__.py:130
msgid "No link found"
msgstr "ບໍ່ພົບລີ້ງຄ໌"

#: __init__.py:69
msgid "No text selected to append"
msgstr "ບໍ່ມີຂໍ້ຄວາມທີ່ຖືກເລືອກເພື່ອຕໍ່ທ້າຍ"

#: __init__.py:30
msgid "Simple Copy"
msgstr "Simple Copy"

#: __init__.py:83
msgid "copy URL (single) copy hyper link (double)"
msgstr "ສຳເນົາ URL (ກົດເທື່ອດຽວ) ສຳເນົາໄຮເປີລີ້ງຄ໌ (ກົດສອງເທື່ອ)"

#: __init__.py:137
msgid "copy and append (single) clear (double)"
msgstr "ສຳເນົາແລະຕໍ່ທ້າຍ (ກົດເທື່ອດຽວ) ລ້າງຄລິບບອດ (ກົດສອງເທື່ອ)"

#: __init__.py:182
msgid "copy last speech (single) append last speech (double) copy until last speech (triple)"
msgstr "ສຳເນົາຄຳເວົ້າສຸດທ້າຍ (ກົດເທື່ອດຽວ) ຕໍ່ທ້າຍຄຳເວົ້າສຸດທ້າຍ (ກົດສອງເທື່ອ) ສຳເນົາຈົນຮອດຄຳເວົ້າສຸດທ້າຍ (ກົດສາມເທື່ອ)"