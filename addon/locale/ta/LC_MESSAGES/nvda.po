#: __init__.py:225
msgid "Append"
msgstr "இணைக்கவும்"

#: clipboard_utils.py:229
msgid "Appended"
msgstr "இணைக்கப்பட்டது"

#: clipboard_utils.py:205
msgid "Cannot append to non-text clipboard content"
msgstr "உரை அல்லாத கிளிப்போர்டு உள்ளடக்கத்துடன் இணைக்க முடியாது"

#: __init__.py:174
msgid "Clean"
msgstr "துடைக்கவும்"

#: clipboard_utils.py:229
msgid "Copied"
msgstr "நகலெடுக்கப்பட்டது"

#: __init__.py:116
#: __init__.py:128
msgid "Copy"
msgstr "நகலெடு"

#: __init__.py:234
msgid "Copy Until Last"
msgstr "கடைசி வரை நகலெடு"

#: __init__.py:80
msgid "Error during append operation"
msgstr "இணைக்கும் செயல்பாட்டின் போது பிழை"

#: clipboard_utils.py:236
msgid "Error writing to clipboard"
msgstr "கிளிப்போர்டில் எழுதும் போது பிழை"

#: __init__.py:239
msgid "Navigate speech history: previous (single) next (double) open log file (triple)"
msgstr "பேச்சு வரலாற்றை வழிநடத்து: முந்தையது (ஒரு முறை அழுத்தவும்) அடுத்தது (இரு முறை அழுத்தவும்) பதிவுக் கோப்பைத் திறக்கவும் (மூன்று முறை அழுத்தவும்)"

#: __init__.py:118
msgid "No URL"
msgstr "URL இல்லை"

#: __init__.py:130
msgid "No link found"
msgstr "இணைப்பு எதுவும் இல்லை"

#: __init__.py:69
msgid "No text selected to append"
msgstr "இணைப்பதற்கு எந்த உரையும் தேர்ந்தெடுக்கப்படவில்லை"

#: __init__.py:30
msgid "Simple Copy"
msgstr "Simple Copy"

#: __init__.py:83
msgid "copy URL (single) copy hyper link (double)"
msgstr "URL-ஐ நகலெடு (ஒரு முறை அழுத்தவும்) ஹைப்பர் லிங்கை நகலெடு (இரு முறை அழுத்தவும்)"

#: __init__.py:137
msgid "copy and append (single) clear (double)"
msgstr "நகலெடுத்து இணைக்கவும் (ஒரு முறை அழுத்தவும்) துடைக்கவும் (இரு முறை அழுத்தவும்)"

#: __init__.py:182
msgid "copy last speech (single) append last speech (double) copy until last speech (triple)"
msgstr "கடைசி பேச்சை நகலெடு (ஒரு முறை அழுத்தவும்) கடைசி பேச்சை இணைக்கவும் (இரு முறை அழுத்தவும்) கடைசி பேச்சு வரை நகலெடு (மூன்று முறை அழுத்தவும்)"