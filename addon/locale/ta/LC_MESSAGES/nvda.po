#: __init__.py:266
msgid "Append"
msgstr "இறுதியில் சேர்"

#: clipboard_utils.py:215
msgid "Appended"
msgstr "இறுதியில் சேர்க்கப்பட்டது"

#: clipboard_utils.py:190
msgid "Cannot append to non-text clipboard content"
msgstr "உரை அல்லாத கிளிப்போர்டு உள்ளடக்கத்தின் இறுதியில் சேர்க்க முடியாது"

#: __init__.py:109
msgid "Clean"
msgstr "துடை"

#: clipboard_utils.py:215
msgid "Copied"
msgstr "நகலெடுக்கப்பட்டது"

#: __init__.py:202
#: __init__.py:214
msgid "Copy"
msgstr "நகலெடு"

#: __init__.py:275
msgid "Copy Until Last"
msgstr "கடைசி வரை நகலெடு"

#: __init__.py:162
msgid "Copy failed"
msgstr "நகலெடுக்க முடியவில்லை"

#: __init__.py:158
msgid "Copy from review"
msgstr "மதிப்பாய்வு कர்சரிலிருந்து நகலெடு"

#: __init__.py:117
msgid "Copy/Append selected text (single) Copy from review cursor (double) Clear clipboard (triple)"
msgstr "தேர்ந்தெடுத்த உரையை நகலெடு/இறுதியில் சேர் (ஒருமுறை அழுத்தவும்), மதிப்பாய்வு कர்சரிலிருந்து நகலெடு (இருமுறை அழுத்தவும்), கிளிப்போர்டைத் துடை (மும்முறை அழுத்தவும்)"

#: __init__.py:98
msgid "Error during append operation"
msgstr "இறுதியில் சேர்க்கும் செயல்பாட்டின் போது பிழை"

#: clipboard_utils.py:223
msgid "Error writing to clipboard"
msgstr "கிளிப்போர்டில் எழுதுவதில் பிழை"

#: __init__.py:280
msgid "Navigate speech history: previous (single) next (double) open log file (triple)"
msgstr "பேச்சு வரலாற்றை உலாவு: முந்தையது (ஒருமுறை அழுத்தவும்), அடுத்தது (இருமுறை அழுத்தவும்), பதிவுக் கோப்பைத் திற (மும்முறை அழுத்தவும்)"

#: __init__.py:204
msgid "No URL"
msgstr "URL இல்லை"

#: __init__.py:216
msgid "No link found"
msgstr "இணைப்பு எதுவும் இல்லை"

#: __init__.py:165
msgid "No text at review cursor"
msgstr "மதிப்பாய்வு कர்சரில் உரை எதுவுமில்லை"

#: __init__.py:71
msgid "No text selected to append"
msgstr "இறுதியில் சேர்க்க உரை எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

#: __init__.py:31
msgid "Simple Copy"
msgstr "Simple Copy"

