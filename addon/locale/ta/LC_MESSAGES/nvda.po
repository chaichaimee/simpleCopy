#: __init__.py:80
#: __init__.py:157
msgid "character"
msgstr "எழுத்து"

#: __init__.py:79
#: __init__.py:80
#: __init__.py:157
msgid "characters"
msgstr "எழுத்துக்கள்"

#: __init__.py:169
msgid "copy URL (single) copy hyper link (double)"
msgstr "URL ஐ நகலெடு (ஒருமுறை அழுத்தவும்), ஹைப்பர் லிங்க்கை நகலெடு (இருமுறை அழுத்தவும்)"

#: __init__.py:223
msgid "copy last speech (single) append last speech (double) copy until last speech (triple)"
msgstr "கடைசி பேச்சை நகலெடு (ஒருமுறை அழுத்தவும்), கடைசி பேச்சை இறுதியில் சேர் (இருமுறை அழுத்தவும்), கடைசி பேச்சு வரை நகலெடு (மும்முறை அழுத்தவும்)"

#: __init__.py:86
msgid "total"
msgstr "மொத்தம்"